# Copy this file to .env and adjust for your environment before running in production.

# --- Server ---
PORT=4000
NODE_ENV=production

# --- Auth ---
# CRITICAL: set a long, random, secret value in production. Do not use the default.
JWT_SECRET=change-this-to-a-long-random-string

# --- First-run admin seed (only used the very first time the DB is empty) ---
SEED_ORG_NAME=Your Organization
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=set-a-strong-password-here

# --- Storage paths (defaults are fine for a single-node deployment;
#     point these at persistent volumes in production, e.g. Docker volumes) ---
DATA_DIR=./data
DB_PATH=./data/platform.db
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# --- Upload limits ---
MAX_UPLOAD_SIZE_BYTES=209715200
